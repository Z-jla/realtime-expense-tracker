{
  "name": "realtime-expense-tracker",
  "private": true,
  "version": "1.1.6",
  "description": "手机优先的个人支出记账应用，支持手动记账、截图 OCR 自动入账和 Android APK 打包。",
  "license": "MIT",
  "author": "",
  "keywords": [
    "expense-tracker",
    "ocr",
    "react",
    "vite",
    "capacitor",
    "android",
    "pwa"
  ],
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:android": "tsc -b && vite build --mode android && node scripts/verify-android-web-assets.mjs",
    "lint": "oxlint",
    "test": "npm run test:logic && npm run test:components",
    "test:logic": "node --test scripts/ocr-parser.test.mjs scripts/expenses.test.mjs",
    "test:components": "vitest run",
    "test:ocr": "node --test scripts/ocr-parser.test.mjs",
    "preview": "vite preview",
    "android:sync": "npm run build:android && cap sync android",
    "android:debug": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-android-debug.ps1",
    "android:copy-debug-apk": "powershell -NoProfile -ExecutionPolicy Bypass -Command \"Copy-Item -LiteralPath 'android/app/build/outputs/apk/debug/app-debug.apk' -Destination '实时记账-debug.apk' -Force\""
  },
  "dependencies": {
    "@capacitor/android": "^8.4.1",
    "@capacitor/app": "^8.1.1",
    "@capacitor/camera": "^8.2.3",
    "@capacitor/core": "^8.4.1",
    "@capacitor/filesystem": "^8.1.3",
    "@capacitor/share": "^8.0.1",
    "lucide-react": "^1.22.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "tesseract.js": "^7.0.0",
    "vite-plugin-pwa": "^1.3.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.4.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.0",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "jsdom": "26.1.0",
    "oxlint": "^1.69.0",
    "typescript": "~6.0.2",
    "vite": "^8.1.0",
    "vitest": "4.1.11"
  }
}
